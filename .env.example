# F.I.S.H. Scholar — server-side environment variables.
# Copy to `.env` (which is git-ignored) and fill in real values.
# NEVER commit real secrets. All keys are used server-side only and are never sent to the client.

# --- AI provider selection ---------------------------------------------------
# Which provider the server uses. One of: gemini | anime_ai
# If unset, the server auto-selects the first configured provider (defaults to gemini).
AI_PROVIDER="gemini"

# --- Google Gemini -----------------------------------------------------------
# GEMINI_API_KEY: required for Gemini AI calls. Without it, AI features degrade gracefully.
GEMINI_API_KEY=""
# GEMINI_MODEL: optional model override. Defaults to a current model family.
GEMINI_MODEL="gemini-2.5-flash"

# --- Anime AI (custom external provider) -------------------------------------
# The adapter stays inert until official API documentation is provided (endpoints/shapes
# are intentionally NOT invented). Provide these plus the docs to finish wiring it.
ANIME_AI_API_KEY=""
ANIME_AI_BASE_URL=""
ANIME_AI_MODEL=""

# --- Notion integration (read-only first) ------------------------------------
# NOTION_API_KEY: server-side Notion integration token. Used for read-only import first.
NOTION_API_KEY=""

# --- GitHub OAuth (optional academic repo sync) ------------------------------
# Without these, GitHub features report "not connected" honestly (no fake identity).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
CLIENT_ID=""
CLIENT_SECRET=""

# --- App ---------------------------------------------------------------------
# APP_URL: the URL where this app is hosted (used for OAuth callbacks / self-links).
APP_URL=""
